# ═══════════════════════════════════════════════════════════════════════════════
# Cholismo Terminal — configuration de PRODUCTION (modèle)
#
#   cp .env.production.example .env.production   puis remplir. NE JAMAIS COMMITTER .env.production.
#
# Toute variable absente retombe sur son défaut de `backend/app/config.py`, et **tout défaut est
# le mode le plus sûr** : sources mockées, IA muette, aucune source externe. Un fichier vide
# démarre donc un terminal de démonstration, jamais un terminal live à moitié configuré.
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# ⛔ CE QUI N'EST PAS ICI, ET NE DOIT PAS Y ÊTRE : LES IDENTIFIANTS COURTIER
# ───────────────────────────────────────────────────────────────────────────────
# `CLAUDE.md` §2.1 : « Aucune exécution automatique d'ordre. Go/No-Go ENREGISTRE une décision,
# ne passe jamais d'ordre. » Aucun module de ce dépôt ne parle à un courtier, et deux tests
# l'interdisent explicitement (`execution_sim`, `replay_harness` : `broker`, `submit_order`,
# `requests`, `socket` sont refusés dans leur source).
#
# Poser ici des identifiants de courtier créerait l'affordance exacte que §2.1 interdit : la
# prochaine personne qui les voit conclut qu'un chemin d'exécution existe quelque part. Le
# passage d'ordre est manuel, dans NinjaTrader, par un humain. Le terminal OBSERVE le fill après
# coup (`NT8_LOG_DIR`) et le réconcilie — il ne le provoque jamais.
#
# Si un jour l'exécution automatique est décidée, ce sera un ADR (`docs/adr/`), pas une variable
# d'environnement ajoutée en silence.

# ───────────────────────────────────────────────────────────────────────────────
# 1. MODE — la bascule Sim / Live porte sur les DONNÉES, jamais sur l'exécution
# ───────────────────────────────────────────────────────────────────────────────
# Trois modes de données, mutuellement exclusifs par construction :
#   · SIM     (défaut)  : `MockDataSource` + pathologies injectées (CLAUDE §4)
#   · REPLAY            : `REPLAY_FILE` renseigné → un tape enregistré est rejoué
#   · LIVE              : `MICROSTRUCTURE_SOURCE` pointe une vraie plateforme
#
# Le moteur ne sait pas laquelle est branchée (couture unique, CLAUDE §4).

# ⚠ `MICROSTRUCTURE_SOURCE` NE BRANCHE AUCUN CONNECTEUR. C'est le nom d'IDENTITÉ LOGIQUE de la
# source qui possède carnet, tape et volumes — il pilote la coupure (`/sources`) et la table de
# provenance, rien de plus. **Aucune source live n'existe encore dans ce dépôt** : les seules
# implémentations de `MarketDataSource` sont `MockDataSource` et `ReplayDataSource`.
#
# Y écrire `rithmic` était un piège que ce template contenait (corrigé D-093) : le mock héritait
# du nom et une séance simulée s'affichait « source : rithmic ». Le mock estampille désormais
# `mock:*` quoi qu'il arrive, et le démarrage l'annonce — mais le nom reste une étiquette.
# Le laisser au défaut tant qu'aucun connecteur ne le rend vrai.
MICROSTRUCTURE_SOURCE=bookmap

# Mode REPLAY : chemin d'un tape CSV. Vide = pas de replay. Renseigné, le terminal l'annonce
# dans son état (`source: replay`) — un rejeu ne se déguise jamais en direct.
REPLAY_FILE=
REPLAY_SPEED=1.0
REPLAY_AUTOPLAY=1

# ───────────────────────────────────────────────────────────────────────────────
# 2. INFRASTRUCTURE
# ───────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Journal append-only (Decision Log + journal des setups). Le SAUVEGARDER : il porte
# l'historique de calibration, et il est immuable par construction — on ne le régénère pas.
EVENT_DB_PATH=/var/lib/cholismo/events.db
SNAPSHOT_DIR=/var/lib/cholismo/snapshots

# ───────────────────────────────────────────────────────────────────────────────
# 3. SOURCES DE MARCHÉ
# ───────────────────────────────────────────────────────────────────────────────
# Rithmic — flux MBO/L2 temps réel. Le connecteur n'existe PAS encore dans ce dépôt (D-083) :
# ces variables sont posées pour le jour du câblage, elles ne sont lues par aucun module
# aujourd'hui. Les laisser vides ne change donc rien.
RITHMIC_USER=
RITHMIC_PASSWORD=
RITHMIC_SYSTEM=
RITHMIC_GATEWAY=

# ThetaData / Unusual Whales — fournisseurs d'options pour le worker autonome.
# ⚠ `workers/options_worker.py` tourne aujourd'hui sur `MockVendorClient` (simulation explicite).
# Brancher un vrai fournisseur = implémenter le `Protocol` `OptionsVendorClient`, pas seulement
# renseigner une clé. Sans ce travail, ces variables sont inertes.
THETADATA_API_KEY=
UNUSUAL_WHALES_API_KEY=
OPTIONS_VENDOR=mock

# Sources externes Niveau 3 (calendrier éco F5 + VIX F3). OPT-IN : sans `EXTERNAL_DATA=1`,
# rien ne tourne et le mock reste seul maître de `vix`/`macro_releases`.
# ⚠ En l'activant, ces champs deviennent ABSENT si la source est injoignable — et Phase 0
# BLOQUE (fail-closed §3). C'est voulu : mieux vaut un terminal qui refuse qu'un terminal qui
# affiche du mock déguisé en réel.
EXTERNAL_DATA=1
FINNHUB_API_KEY=
FRED_API_KEY=

# NinjaTrader — OBSERVATION seule (§2.1). Le scraper lit les fills DÉJÀ passés par l'humain.
NT8_LOG_DIR=
NT8_ACCOUNT_FILE=

# ───────────────────────────────────────────────────────────────────────────────
# 4. IA — asynchrone uniquement, JAMAIS dans le hot path (CLAUDE §2.8)
# ───────────────────────────────────────────────────────────────────────────────
# Clés absentes = état UNAVAILABLE explicite, jamais un blocage ni une valeur inventée.
# Groq est ADVISORY sur Phase 0 : il ne peut pas ouvrir un verrou, seulement commenter.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Export Notion du journal des setups (D-118) — service AUTONOME, hors du terminal.
# OPT-IN STRICT : sans les DEUX variables, RIEN n'est envoyé. Les données de trading ne partent
# vers un service tiers que sur demande explicite.
#   python workers/notion_exporter.py
# ⚠ Le format d'API n'a été confronté à aucun service réel. Le mappage est testé, pas la
# conformité à l'API Notion.
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_POLL_SECONDS=60

# ───────────────────────────────────────────────────────────────────────────────
# 5. BOUCLES — cadences et seuils (voir D-073 / D-077)
# ───────────────────────────────────────────────────────────────────────────────
# Tous PLACEHOLDER : aucun n'a été calibré sur données. Les changer est un choix documenté,
# pas un réglage de confort.
OPTIONS_SYNC_PERIOD_SECONDS=5.0
OPTIONS_CONTEXT_TTL_SECONDS=90.0
O5_SAMPLE_PERIOD_SECONDS=5.0
O5_BAR_PERIOD_SECONDS=60.0
LSR_SWEEP_MAX_PENDING_S=30.0

# ───────────────────────────────────────────────────────────────────────────────
# 6. FRONTEND
# ───────────────────────────────────────────────────────────────────────────────
VITE_API_BASE=http://localhost:8000
# Un opérateur par instance, backend partagé (CLAUDE §9).
VITE_OPERATOR=SONY
